---
import { SITE_BRAND } from "../consts";

const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.replace(/\/$/, "");
---

<header class="bg-surface sticky top-0 z-50 transition-all duration-300 border-b border-outline-variant/40 shadow-sm">
  <nav class="flex justify-between items-center w-full px-4 md:px-10 max-w-[1120px] mx-auto h-20">
    <!-- Brand Logo -->
    <div class="flex items-center gap-8">
      <a class="flex items-center gap-2 group" href="/">
        <span class="w-10 h-10 rounded-full bg-primary flex items-center justify-center text-white font-serif text-xl font-bold shadow-sm group-hover:bg-primary-hover transition-colors">
          S
        </span>
        <div class="flex flex-col">
          <span class="font-serif text-2xl font-bold text-primary tracking-tight leading-none group-hover:text-primary-hover transition-colors">
            {SITE_BRAND}
          </span>
          <span class="text-[10px] font-sans uppercase tracking-widest text-on-surface-variant font-semibold">
            Cocina Española
          </span>
        </div>
      </a>

      <!-- Desktop Nav Links -->
      <div class="hidden md:flex items-center gap-6">
        <a 
          class={`font-sans text-xs font-semibold uppercase tracking-wider transition-colors hover:text-primary pb-1 ${
            currentPath === "" || currentPath === "/" ? "text-primary border-b-2 border-primary" : "text-on-surface-variant"
          }`} 
          href="/"
        >
          Inicio
        </a>
        <a 
          class={`font-sans text-xs font-semibold uppercase tracking-wider transition-colors hover:text-primary pb-1 ${
            currentPath.startsWith("/recetas") ? "text-primary border-b-2 border-primary" : "text-on-surface-variant"
          }`} 
          href="/recetas"
        >
          Recetas
        </a>
        <a 
          class={`font-sans text-xs font-semibold uppercase tracking-wider transition-colors hover:text-primary pb-1 ${
            currentPath.startsWith("/categorias") ? "text-primary border-b-2 border-primary" : "text-on-surface-variant"
          }`} 
          href="/categorias"
        >
          Categorías
        </a>
        <a 
          class={`font-sans text-xs font-semibold uppercase tracking-wider transition-colors hover:text-primary pb-1 ${
            currentPath.startsWith("/dashboard") ? "text-primary border-b-2 border-primary" : "text-on-surface-variant"
          }`} 
          href="/dashboard"
        >
          Dashboard
        </a>
      </div>
    </div>

    <!-- Actions & Mobile Menu -->
    <div class="flex items-center gap-4">
      <form action="/recetas" method="GET" class="relative hidden sm:block">
        <input
          type="text"
          name="q"
          placeholder="Buscar recetas (paella, tortilla)..."
          class="w-48 lg:w-64 bg-surface-container text-xs text-on-surface px-3 py-2 pl-9 rounded-full border border-outline-variant focus:outline-none focus:border-primary transition-all"
        />
        <span class="material-symbols-outlined absolute left-2.5 top-2 text-on-surface-variant text-base">
          search
        </span>
      </form>

      <a href="/dashboard" class="btn-primary py-2 px-4 text-xs font-semibold rounded-full hidden sm:inline-flex">
        <span class="material-symbols-outlined text-base">admin_panel_settings</span>
        Panel
      </a>

      <!-- Mobile Toggle -->
      <button 
        id="mobile-menu-btn"
        class="md:hidden p-2 text-on-surface-variant hover:text-primary focus:outline-none"
        aria-label="Abrir menú"
      >
        <span class="material-symbols-outlined text-2xl">menu</span>
      </button>
    </div>
  </nav>

  <!-- Mobile Drawer -->
  <div id="mobile-menu" class="hidden md:hidden bg-surface border-b border-outline-variant px-6 py-4 flex-col gap-3">
    <a class="text-sm font-semibold uppercase tracking-wider text-on-surface hover:text-primary py-2" href="/">
      Inicio
    </a>
    <a class="text-sm font-semibold uppercase tracking-wider text-on-surface hover:text-primary py-2" href="/recetas">
      Recetas
    </a>
    <a class="text-sm font-semibold uppercase tracking-wider text-on-surface hover:text-primary py-2" href="/categorias">
      Categorías
    </a>
    <a class="text-sm font-semibold uppercase tracking-wider text-on-surface hover:text-primary py-2" href="/dashboard">
      Dashboard Admin
    </a>
    <form action="/recetas" method="GET" class="relative mt-2">
      <input
        type="text"
        name="q"
        placeholder="Buscar recetas..."
        class="w-full bg-surface-container text-xs text-on-surface px-3 py-2 pl-9 rounded-full border border-outline-variant"
      />
      <span class="material-symbols-outlined absolute left-2.5 top-2 text-on-surface-variant text-base">
        search
      </span>
    </form>
  </div>
</header>

<script is:inline>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
      menu.classList.toggle('flex');
    });
  }
</script>
