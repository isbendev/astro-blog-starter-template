---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AdSense from '../../components/AdSense.astro';
import CommentSection from '../../components/CommentSection.astro';
import { SITE_BRAND } from '../../consts';
import { getRecipeBySlug, getComments, getSettings } from '../../lib/db';

export const prerender = false;

const { slug } = Astro.params;
if (!slug) {
  return Astro.redirect('/recetas');
}

const db = (Astro.locals as any)?.runtime?.env?.DB;
const recipe = await getRecipeBySlug(slug, db);
if (!recipe) {
  return Astro.redirect('/recetas');
}

const comments = await getComments(recipe.slug, db, false);
const settings = await getSettings(db);
---

<!DOCTYPE html>
<html lang="es">
	<head>
		<BaseHead 
			title={`${recipe.title} | ${SITE_BRAND}`} 
			description={recipe.description} 
			image={recipe.heroImage}
		/>
	</head>
	<body class="bg-surface text-on-surface">
		<Header />
		
		<main class="max-w-[1120px] mx-auto px-4 md:px-10 py-10" id="recipe-main">
			<!-- Breadcrumb & Back Link -->
			<nav class="flex items-center gap-2 text-xs font-semibold text-on-surface-variant uppercase tracking-wider mb-6">
				<a href="/" class="hover:text-primary">Inicio</a>
				<span>/</span>
				<a href="/recetas" class="hover:text-primary">Recetas</a>
				<span>/</span>
				<span class="text-primary truncate">{recipe.title}</span>
			</nav>

			<!-- Recipe Title & Hero Header -->
			<div class="mb-8">
				<div class="flex items-center gap-3 mb-3">
					<span class="badge-terracotta">{recipe.categoryLabel}</span>
					<span class="text-xs font-semibold text-secondary uppercase tracking-wider">Dificultad {recipe.difficulty}</span>
				</div>
				
				<h1 class="font-serif text-3xl md:text-5xl font-bold text-on-surface mb-4 leading-tight">
					{recipe.title}
				</h1>
				
				<p class="text-sm md:text-base text-on-surface-variant leading-relaxed max-w-3xl mb-6">
					{recipe.description}
				</p>

				<!-- Metadata Stats Bar -->
				<div class="bg-surface-container rounded-xl p-4 md:p-6 border border-outline-variant grid grid-cols-2 sm:grid-cols-4 gap-4 text-center">
					<div class="border-r border-outline-variant/60 last:border-0">
						<span class="material-symbols-outlined text-primary text-xl block mb-1">timer</span>
						<span class="text-[10px] uppercase font-bold text-on-surface-variant block">Prep</span>
						<span class="font-bold text-sm text-on-surface">{recipe.prepTime}</span>
					</div>
					<div class="border-r border-outline-variant/60 last:border-0">
						<span class="material-symbols-outlined text-primary text-xl block mb-1">skillet</span>
						<span class="text-[10px] uppercase font-bold text-on-surface-variant block">Cocción</span>
						<span class="font-bold text-sm text-on-surface">{recipe.cookTime}</span>
					</div>
					<div class="border-r border-outline-variant/60 last:border-0">
						<span class="material-symbols-outlined text-primary text-xl block mb-1">group</span>
						<span class="text-[10px] uppercase font-bold text-on-surface-variant block">Raciones</span>
						<span class="font-bold text-sm text-on-surface">{recipe.servings} personas</span>
					</div>
					<div>
						<span class="material-symbols-outlined text-primary text-xl block mb-1">workspace_premium</span>
						<span class="text-[10px] uppercase font-bold text-on-surface-variant block">Nivel</span>
						<span class="font-bold text-sm text-on-surface">{recipe.difficulty}</span>
					</div>
				</div>
			</div>

			<!-- Hero Photography & Cook Mode Toggle Bar -->
			<div class="relative rounded-2xl overflow-hidden shadow-lg border border-outline-variant mb-12 aspect-[16/9] md:aspect-[21/9]">
				<img 
					src={recipe.heroImage} 
					alt={recipe.title} 
					class="w-full h-full object-cover"
				/>
				<div class="absolute bottom-4 right-4 z-20">
					<button 
						id="cook-mode-btn"
						class="btn-secondary bg-surface/90 backdrop-blur-md shadow-md text-xs py-2.5 px-4 font-bold flex items-center gap-2"
					>
						<span class="material-symbols-outlined text-base text-primary">cooking</span>
						<span id="cook-mode-text">Activar Modo Cocina</span>
					</button>
				</div>
			</div>

			<!-- In-Article AdSense Banner -->
			<AdSense slotId="recipe-in-article" publisherId={settings.adsense_pub_id} className="mb-12" />

			<!-- Recipe Content Layout Grid -->
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-12" id="recipe-body-grid">
				<!-- Left Column: Ingredients Checklist (4 cols) -->
				<aside class="lg:col-span-4">
					<div class="bg-surface-container rounded-xl p-6 border border-outline-variant sticky top-24">
						<div class="flex items-center justify-between border-b border-outline-variant pb-3 mb-6">
							<h3 class="font-serif text-2xl font-bold text-on-surface flex items-center gap-2">
								<span class="material-symbols-outlined text-primary">shopping_basket</span>
								Ingredientes
							</h3>
							<span class="text-xs font-semibold text-on-surface-variant bg-surface px-2.5 py-1 rounded border border-outline-variant">
								{recipe.servings} porciones
							</span>
						</div>

						<p class="text-xs text-on-surface-variant mb-4 italic">
							Haz clic en las casillas conforme reúnas o uses cada ingrediente:
						</p>

						<ul class="space-y-3" id="ingredients-list">
							{recipe.ingredients.map((ing, index) => (
								<li class="flex items-start gap-3 text-xs md:text-sm text-on-surface leading-snug">
									<input 
										type="checkbox" 
										id={`ing-${index}`} 
										class="ingredient-checkbox mt-0.5" 
									/>
									<label htmlFor={`ing-${index}`} class="cursor-pointer select-none font-medium">
										{ing}
									</label>
								</li>
							))}
						</ul>

						<div class="mt-8 pt-4 border-t border-outline-variant text-center">
							<button 
								onclick="window.print()" 
								class="text-xs font-semibold text-secondary hover:text-primary flex items-center justify-center gap-1 mx-auto"
							>
								<span class="material-symbols-outlined text-sm">print</span>
								Imprimir Ficha de Receta
							</button>
						</div>
					</div>
				</aside>

				<!-- Right Column: Step-by-Step Instructions (8 cols) -->
				<div class="lg:col-span-8">
					<div class="bg-surface rounded-xl p-6 md:p-8 border border-outline-variant/60">
						<h3 class="font-serif text-2xl md:text-3xl font-bold text-on-surface border-b border-outline-variant pb-4 mb-8 flex items-center gap-2">
							<span class="material-symbols-outlined text-primary text-3xl">soup_kitchen</span>
							Elaboración Paso a Paso
						</h3>

						<ol class="space-y-8" id="instructions-list">
							{recipe.instructions.map((step, idx) => (
								<li class="flex gap-4 items-start">
									<span class="w-8 h-8 rounded-full bg-primary text-white flex-shrink-0 flex items-center justify-center font-bold text-sm font-serif shadow-sm mt-1">
										{idx + 1}
									</span>
									<div class="flex-grow pt-1">
										<p class="text-sm md:text-base text-on-surface-variant leading-relaxed font-sans">
											{step}
										</p>
									</div>
								</li>
							))}
						</ol>

						<!-- Chef Tips Box -->
						<div class="mt-12 bg-secondary-container/40 rounded-xl p-6 border border-secondary/30 flex gap-4 items-start">
							<span class="material-symbols-outlined text-secondary text-3xl">lightbulb</span>
							<div>
								<h4 class="font-serif font-bold text-base text-secondary mb-1">Consejo del Chef Carmen</h4>
								<p class="text-xs text-on-surface-variant leading-relaxed">
									Para potenciar los sabores al máximo, utiliza siempre aceite de oliva virgen extra recién abierto e ingredientes de cercanía o de temporada.
								</p>
							</div>
						</div>
					</div>

					<!-- Comments Section Component -->
					<CommentSection recipeSlug={recipe.slug} comments={comments} />
				</div>
			</div>
		</main>

		<Footer />

		<script is:inline>
			const cookBtn = document.getElementById('cook-mode-btn');
			const cookText = document.getElementById('cook-mode-text');
			const recipeMain = document.getElementById('recipe-main');
			let cookModeActive = false;

			if (cookBtn && recipeMain) {
				cookBtn.addEventListener('click', () => {
					cookModeActive = !cookModeActive;
					if (cookModeActive) {
						recipeMain.classList.add('text-lg', 'max-w-full', 'px-8');
						if (cookText) cookText.innerText = 'Desactivar Modo Cocina';
						cookBtn.classList.add('bg-primary', 'text-white');
					} else {
						recipeMain.classList.remove('text-lg', 'max-w-full', 'px-8');
						if (cookText) cookText.innerText = 'Activar Modo Cocina';
						cookBtn.classList.remove('bg-primary', 'text-white');
					}
				});
			}
		</script>
	</body>
</html>
