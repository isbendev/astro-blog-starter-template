---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_BRAND, CATEGORIES } from '../consts';
import { getRecipes, getSettings } from '../lib/db';

export const prerender = false;

const db = (Astro.locals as any)?.runtime?.env?.DB;
const allRecipes = await getRecipes(db);
const settings = await getSettings(db);
---

<!DOCTYPE html>
<html lang="es">
	<head>
		<BaseHead 
			title={`Categorías de Cocina Española | ${SITE_BRAND}`} 
			description="Explora nuestras recetas divididas por estilos: Tapas, Platos Principales, Sopas y Postres." 
		/>
	</head>
	<body class="bg-surface text-on-surface">
		<Header />
		
		<main class="max-w-[1120px] mx-auto px-4 md:px-10 py-12">
			<div class="text-center max-w-2xl mx-auto mb-14">
				<span class="text-xs font-semibold text-primary uppercase tracking-widest block mb-2">Explora por Temáticas</span>
				<h1 class="font-serif text-4xl md:text-5xl font-bold text-on-surface mb-4">
					Categorías Gastronómicas
				</h1>
				<p class="text-xs md:text-sm text-on-surface-variant leading-relaxed">
					Desde los aperitivos de tasca tradicional hasta los asados dominicales y la repostería artesana.
				</p>
			</div>

			<div class="space-y-16">
				{CATEGORIES.map((cat) => {
					const categoryRecipes = allRecipes.filter(r => r.category === cat.id);
					return (
						<section class="bg-surface-container rounded-2xl p-6 md:p-10 border border-outline-variant shadow-sm">
							<div class="flex flex-col md:flex-row md:items-center justify-between border-b border-outline-variant pb-4 mb-8 gap-2">
								<div>
									<span class="badge-olive mb-2">{categoryRecipes.length} Recetas</span>
									<h2 class="font-serif text-3xl font-bold text-on-surface">{cat.name}</h2>
									<p class="text-xs text-on-surface-variant">{cat.description}</p>
								</div>
								<a 
									href={`/recetas?category=${cat.id}`}
									class="btn-primary py-2 px-5 text-xs font-semibold self-start md:self-auto"
								>
									Ver Categoría Completa
								</a>
							</div>

							<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
								{categoryRecipes.slice(0, 3).map((recipe) => (
									<article class="recipe-card-hover bg-surface rounded-xl overflow-hidden border border-outline-variant/60 flex flex-col">
										<a href={`/recetas/${recipe.slug}`} class="relative aspect-[4/3] block overflow-hidden">
											<img 
												src={recipe.heroImage} 
												alt={recipe.title} 
												class="w-full h-full object-cover image-zoom"
											/>
										</a>
										<div class="p-5 flex flex-col justify-between flex-grow">
											<div>
												<span class="text-[10px] font-bold uppercase text-secondary block mb-1">
													{recipe.prepTime} • {recipe.difficulty}
												</span>
												<h3 class="font-serif font-bold text-lg text-on-surface mb-2 line-clamp-1 hover:text-primary">
													<a href={`/recetas/${recipe.slug}`}>{recipe.title}</a>
												</h3>
												<p class="text-xs text-on-surface-variant line-clamp-2 mb-4">
													{recipe.description}
												</p>
											</div>
											<a href={`/recetas/${recipe.slug}`} class="text-xs font-bold text-primary uppercase tracking-wider flex items-center gap-1">
												Ver Receta <span class="material-symbols-outlined text-sm">arrow_forward</span>
											</a>
										</div>
									</article>
								))}
							</div>
						</section>
					);
				})}
			</div>
		</main>

		<Footer />
	</body>
</html>
