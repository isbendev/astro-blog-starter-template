---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AdSense from '../../components/AdSense.astro';
import { SITE_BRAND, CATEGORIES } from '../../consts';
import { getRecipes, getSettings } from '../../lib/db';

export const prerender = false;

const url = new URL(Astro.request.url);
const selectedCategory = url.searchParams.get('category') || 'all';
const searchQuery = url.searchParams.get('q') || '';

const db = (Astro.locals as any)?.runtime?.env?.DB;
const recipes = await getRecipes(db, selectedCategory, searchQuery);
const settings = await getSettings(db);
---

<!DOCTYPE html>
<html lang="es">
	<head>
		<BaseHead 
			title={`Recetas Tradicionales | ${SITE_BRAND}`} 
			description="Catálogo completo de recetas españolas caseras con explicaciones paso a paso." 
		/>
	</head>
	<body class="bg-surface text-on-surface">
		<Header />
		
		<main class="max-w-[1120px] mx-auto px-4 md:px-10 py-10">
			<!-- Header Title & Filter Bar -->
			<div class="mb-10 text-center max-w-2xl mx-auto">
				<span class="text-xs font-semibold text-primary uppercase tracking-widest block mb-2">Recetario Completo</span>
				<h1 class="font-serif text-4xl md:text-5xl font-bold text-on-surface mb-4">
					Descubre la Auténtica Cocina Española
				</h1>
				<p class="text-xs md:text-sm text-on-surface-variant leading-relaxed">
					Filtra por categoría o busca tu plato preferido: desde arroces y guisos hasta las tapas más célebres.
				</p>
			</div>

			<!-- Search & Category Filters -->
			<div class="bg-surface-container rounded-xl p-6 border border-outline-variant mb-12 shadow-sm">
				<form action="/recetas" method="GET" class="flex flex-col md:flex-row gap-4 mb-6">
					<div class="relative flex-grow">
						<input 
							type="text" 
							name="q" 
							value={searchQuery}
							placeholder="Buscar por ingrediente o nombre (ej. paella, jamón, gambas)..."
							class="w-full bg-surface text-sm text-on-surface px-4 py-3 pl-10 rounded border border-outline-variant focus:outline-none focus:border-primary"
						/>
						<span class="material-symbols-outlined absolute left-3 top-3 text-on-surface-variant">search</span>
					</div>
					<button type="submit" class="btn-primary py-3 px-8 text-xs font-bold whitespace-nowrap">
						Buscar Recetas
					</button>
				</form>

				<!-- Filter Pills -->
				<div class="flex flex-wrap items-center gap-2 pt-2 border-t border-outline-variant/60">
					<span class="text-xs font-semibold uppercase text-on-surface-variant mr-2">Categoría:</span>
					<a 
						href="/recetas" 
						class={`px-4 py-1.5 rounded-full text-xs font-semibold uppercase tracking-wider transition-colors ${
							selectedCategory === 'all' 
								? 'bg-primary text-white' 
								: 'bg-surface text-on-surface-variant hover:bg-surface-container-high border border-outline-variant'
						}`}
					>
						Todas
					</a>
					{CATEGORIES.map((cat) => (
						<a 
							href={`/recetas?category=${cat.id}`}
							class={`px-4 py-1.5 rounded-full text-xs font-semibold uppercase tracking-wider transition-colors ${
								selectedCategory === cat.id 
									? 'bg-primary text-white' 
									: 'bg-surface text-on-surface-variant hover:bg-surface-container-high border border-outline-variant'
							}`}
						>
							{cat.name}
						</a>
					))}
				</div>
			</div>

			<!-- Results Count -->
			<div class="flex items-center justify-between mb-6 text-xs text-on-surface-variant">
				<span>Mostrando <strong class="text-on-surface font-semibold">{recipes.length}</strong> recetas</span>
				{searchQuery && (
					<a href="/recetas" class="text-primary hover:underline flex items-center gap-1 font-semibold">
						Limpiar búsqueda "{searchQuery}"
						<span class="material-symbols-outlined text-sm">close</span>
					</a>
				)}
			</div>

			<!-- Recipes Grid -->
			{recipes.length === 0 ? (
				<div class="bg-surface-container rounded-xl p-12 text-center border border-outline-variant my-8">
					<span class="material-symbols-outlined text-5xl text-on-surface-variant mb-3">search_off</span>
					<h3 class="font-serif text-2xl font-bold text-on-surface mb-2">No encontramos recetas con tu búsqueda</h3>
					<p class="text-xs text-on-surface-variant mb-6">Prueba a buscar con otra palabra clave o explora todas las categorías.</p>
					<a href="/recetas" class="btn-primary py-2.5 px-6 text-xs">Ver Todas las Recetas</a>
				</div>
			) : (
				<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
					{recipes.map((recipe) => (
						<article class="recipe-card-hover bg-surface-container rounded-xl overflow-hidden border border-outline-variant/60 flex flex-col h-full">
							<a href={`/recetas/${recipe.slug}`} class="relative overflow-hidden aspect-[4/3] block">
								<img 
									src={recipe.heroImage} 
									alt={recipe.title} 
									class="w-full h-full object-cover image-zoom"
								/>
								<span class="absolute top-3 left-3 badge-terracotta text-[10px]">
									{recipe.categoryLabel}
								</span>
							</a>

							<div class="p-6 flex flex-col justify-between flex-grow">
								<div>
									<div class="flex items-center gap-3 text-[11px] font-semibold text-on-surface-variant uppercase tracking-wider mb-2">
										<span class="flex items-center gap-1 text-secondary">
											<span class="material-symbols-outlined text-sm">schedule</span>
											{recipe.prepTime}
										</span>
										<span>•</span>
										<span class="text-primary font-medium">Dificultad {recipe.difficulty}</span>
									</div>

									<h3 class="font-serif text-xl font-bold text-on-surface mb-3 line-clamp-2 hover:text-primary transition-colors">
										<a href={`/recetas/${recipe.slug}`}>{recipe.title}</a>
									</h3>

									<p class="text-xs text-on-surface-variant line-clamp-3 mb-6 leading-relaxed">
										{recipe.description}
									</p>
								</div>

								<div class="pt-4 border-t border-outline-variant flex items-center justify-between">
									<span class="text-xs font-semibold text-on-surface-variant flex items-center gap-1">
										<span class="material-symbols-outlined text-sm">group</span>
										{recipe.servings} raciones
									</span>
									<a 
										href={`/recetas/${recipe.slug}`}
										class="text-xs font-bold text-primary uppercase tracking-wider flex items-center gap-1 hover:text-primary-hover"
									>
										Ver Receta
										<span class="material-symbols-outlined text-sm">arrow_forward</span>
									</a>
								</div>
							</div>
						</article>
					))}
				</div>
			)}

			<AdSense slotId="catalog-bottom" publisherId={settings.adsense_pub_id} className="mt-12" />
		</main>

		<Footer />
	</body>
</html>
