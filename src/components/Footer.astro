---
import { SITE_BRAND, SITE_AUTHOR } from "../consts";
const today = new Date();
---

<footer class="bg-surface-container-high border-t border-outline-variant mt-20 text-on-surface">
  <div class="max-w-[1120px] mx-auto px-4 md:px-10 py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 mb-12">
      <!-- Col 1: Brand & Bio -->
      <div class="md:col-span-1">
        <div class="flex items-center gap-2 mb-4">
          <span class="w-8 h-8 rounded-full bg-primary flex items-center justify-center text-white font-serif text-lg font-bold">
            S
          </span>
          <span class="font-serif text-xl font-bold text-primary">
            {SITE_BRAND}
          </span>
        </div>
        <p class="text-xs text-on-surface-variant leading-relaxed mb-4">
          El rincón de la gastronomía española tradicional. Recetas paso a paso con el aroma, sabor y amor de nuestras abuelas.
        </p>
        <div class="flex gap-3 text-secondary">
          <span class="material-symbols-outlined cursor-pointer hover:text-primary transition-colors">restaurant</span>
          <span class="material-symbols-outlined cursor-pointer hover:text-primary transition-colors">local_dining</span>
          <span class="material-symbols-outlined cursor-pointer hover:text-primary transition-colors">menu_book</span>
        </div>
      </div>

      <!-- Col 2: Categorías -->
      <div>
        <h4 class="font-serif text-base font-bold text-on-surface mb-4">Categorías</h4>
        <ul class="space-y-2 text-xs font-medium text-on-surface-variant">
          <li><a href="/recetas?category=tapas" class="hover:text-primary transition-colors">Tapas y Entrantes</a></li>
          <li><a href="/recetas?category=principales" class="hover:text-primary transition-colors">Platos Principales</a></li>
          <li><a href="/recetas?category=sopas" class="hover:text-primary transition-colors">Sopas y Cremas</a></li>
          <li><a href="/recetas?category=postres" class="hover:text-primary transition-colors">Postres Tradicionales</a></li>
        </ul>
      </div>

      <!-- Col 3: Enlaces Rápidos -->
      <div>
        <h4 class="font-serif text-base font-bold text-on-surface mb-4">Explorar</h4>
        <ul class="space-y-2 text-xs font-medium text-on-surface-variant">
          <li><a href="/recetas" class="hover:text-primary transition-colors">Todas las Recetas</a></li>
          <li><a href="/categorias" class="hover:text-primary transition-colors">Ver Categorías</a></li>
          <li><a href="/dashboard" class="hover:text-primary transition-colors">Panel Admin / Dashboard</a></li>
          <li><a href="/rss.xml" class="hover:text-primary transition-colors">Canal RSS</a></li>
        </ul>
      </div>

      <!-- Col 4: Newsletter -->
      <div>
        <h4 class="font-serif text-base font-bold text-on-surface mb-4">Boletín Culinario</h4>
        <p class="text-xs text-on-surface-variant mb-3">
          Recibe cada semana una nueva receta tradicional española en tu correo.
        </p>
        <form class="flex flex-col gap-2" onsubmit="event.preventDefault(); alert('¡Gracias por suscribirte!');">
          <input 
            type="email" 
            placeholder="Tu email..." 
            required
            class="bg-surface text-xs text-on-surface px-3 py-2 rounded border border-outline-variant focus:outline-none focus:border-primary"
          />
          <button type="submit" class="btn-primary py-2 text-xs justify-center">
            Suscribirme
          </button>
        </form>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-outline-variant pt-8 flex flex-col md:flex-row justify-between items-center text-xs text-on-surface-variant gap-4">
      <p>&copy; {today.getFullYear()} {SITE_BRAND}. Creado con amor para amantes de la buena mesa por {SITE_AUTHOR}.</p>
      <div class="flex gap-4">
        <span>Aviso Legal</span>
        <span>Política de Privacidad</span>
        <span>Google AdSense Partner</span>
      </div>
    </div>
  </div>
</footer>
